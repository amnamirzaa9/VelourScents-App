<%-include('partials/header',{activepage:'',title:'checkout',cartcount:cartcount})%>

    <!--billing information-->
    <div class="container py-5">
    <div class="row mt-4">
      <div class="col-md-7 col-12 ">
        <h2 class="section-heading fs-2 text-uppercase">Billing Information</h2>
        <form class="needs-validation" action="/checkout" method="POST" novalidate>
          <div class="row g-3">
            <div class="col-sm-6">
              <label for="firstName" class="form-label">First name</label>
              <input type="text" class="form-control" name="firstname" id="firstName" minlength="2" maxlength="30"  pattern="[A-Za-z]+(?:\s+[A-Za-z]+)*" required>
              <div class="invalid-feedback">Valid first name is required and cannot contain numbers,spaces or special characters.</div>
            </div>

            <div class="col-sm-6">
              <label for="lastName" class="form-label">Last name</label>
              <input type="text" class="form-control" name="lastname" id="lastName" minlength="2" maxlength="30"  pattern="[A-Za-z]+(?:\s+[A-Za-z]+)*" required>
              <div class="invalid-feedback">Valid last name is required and cannot contain numbers,spaces or special characters.</div>
            </div>

            <div class="col-sm-6">
              <label for="phonenumber" class="form-label">Phone Number</label>
              <input type="tel" class="form-control" name="phonenumber" id="phonenumber"  placeholder="03XXXXXXXXX" pattern="03[0-9]{9}" required>
              <div class="invalid-feedback">Valid phone number is required and must be a valid Pakistani phone number.</div>
            </div>

            <div class="col-12">
              <label for="address" class="form-label">Address</label>
              <input type="text" class="form-control" id="address" name="address" placeholder="1234 Main St" min="2" maxlength="200" required>
              <div class="invalid-feedback">Please enter your shipping address.</div>
            </div>

            <div class="col-md-5">
              <label for="city" class="form-label">City</label>
              <select class="form-select" id="city" name="city" required>
    <option value="">Choose...</option>
    <option value="Islamabad">Islamabad</option>
    <option value="Rawalpindi">Rawalpindi</option>
    <option value="Lahore">Lahore</option>
    <option value="Karachi">Karachi</option>
    <option value="Multan">Multan</option>
    <option value="Faisalabad">Faisalabad</option>
    <option value="Quetta">Quetta</option>
</select>
              <div class="invalid-feedback">Please select a valid city.</div>
            </div>

            <div class="col-md-3">
              <label for="postal-code" class="form-label">Postal Code (optional)</label>
              <input type="text" class="form-control" name="code" pattern="[0-9]{5}" id="postal-code">
              <div class="invalid-feedback">Enter a valid postal code(5-digits)</div>
            </div>
          </div>

          <hr class="my-4">

          <div class="form-check">
            <input type="checkbox" name="sameAddress" class="form-check-input"  id="same-address">
            <label class="form-check-label" for="same-address">Shipping address is the same as my billing address</label>
          </div>
          <div class="form-check">
            <input type="checkbox" name="saveInfo" class="form-check-input" id="save-info">
            <label class="form-check-label" for="save-info">Save this information for next time</label>
          </div>

          <hr class="my-4">

          <h4 class="mb-3">Payment Method</h4>

<div class="my-3">

  <!-- Cash on Delivery -->
  <div class="form-check mb-3">
    <input 
      id="cod" 
      name="paymentMethod" 
      value="cod"
      type="radio" 
      class="form-check-input" 
      checked 
      required>
      
    <label class="form-check-label" for="cod">
      Cash on Delivery
    </label>
  
  </div>

  <!-- JazzCash -->
  <div class="form-check mb-3">
    <input 
      id="jazzcash" 
      name="paymentMethod" 
      value="jazzcash"
      type="radio" 
      class="form-check-input" 
      required>
    <label class="form-check-label" for="jazzcash">
      JazzCash
    </label>
  </div>

  <!-- Easypaisa -->
  <div class="form-check mb-3">
    <input 
      id="easypaisa" 
      name="paymentMethod" 
      value="easypaisa"
      type="radio" 
      class="form-check-input" 
      required>
    <label class="form-check-label" for="easypaisa">
      Easypaisa
    </label>
  </div>

  <!-- Bank Transfer -->
  <div class="form-check mb-3">
    <input 
      id="bank" 
      name="paymentMethod" 
      value="bank"
      type="radio" 
      class="form-check-input" 
      required>
    <label class="form-check-label" for="bank">
      Bank Transfer
    </label>
  </div>

</div>

          <button class="w-100 btn btn-primary mb-4 btn-lg mt-4 btn-checkout" type="submit" id="orderbtn">Place order</button>
        </form>
      </div>

     <div class="col-md-5 col-12 d-flex align-items-center justify-content-center">

    <div class="card mb-4 w-100 cart-summary-card">

        <div class="card-body">

            <h5 class="card-title text-center mb-4">
                Cart Summary
            </h5>

            <p class="card-text d-flex justify-content-between mb-3">
                <span>Subtotal</span>
                <span>Rs. <%=subtotal%></span>
            </p>

            <p class="card-text d-flex justify-content-between mb-3">
                <span>Delivery Charges</span>

                <span>
                    <% 
                        let shipping = subtotal<5000?250:0;
                        let total=shipping+subtotal;
                    %>

                    Rs. <%=shipping%>
                </span>
            </p>

            <hr>

            <p class="card-text fw-bold d-flex justify-content-between fs-5 mb-0">
                <span>Total</span>
                <span>Rs. <%=total%></span>
            </p>

        </div>

    </div>

</div>
    </div>
    </div>

  <%-include('partials/footer')%>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <!--custom script-->
    <script>
      const radios=document.querySelectorAll('input[name=paymentMethod]');
      const orderbtn=document.getElementById('orderbtn');
      radios.forEach(radio=>{
        radio.addEventListener('change',()=>{
          if(radio.value==='cod'){
            orderbtn.textContent='Place Order';
          }
          else{
            orderbtn.textContent='Pay Now'
          }
        })
      })
    </script>
 
  <script>

(() => {
    'use strict';

    const forms = document.querySelectorAll('.needs-validation');

    Array.from(forms).forEach(form => {

        form.addEventListener('submit', event => {

            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }

            form.classList.add('was-validated');

        }, false);

    });
})();
</script>
</body>
</html>
