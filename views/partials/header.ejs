<!--header-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%=title%></title>
  
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Playfair+Display:wght@500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container-fluid p-0">
  <!--nav bar-->
  <nav class="navbar navbar-expand-lg bg-body-tertiary">
  
 <a class="navbar-brand d-flex align-items-center gap-2" href="#">
    <img src="/images/velour_scents_flower_icon.svg" alt="Velour Scents" height="30">
    Velour Scents
</a>
<form class="d-flex" action="/search" method="post" role="search">
        <input class="form-control me-2" name="search" type="search" placeholder="Search Your Favorites" aria-label="Search" style="max-width: 300px;"/>
        <button class="btn btn-outline-dark" type="submit">Search</button>
      </form>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse justify-content-center" id="navbarSupportedContent">
      <ul class="navbar-nav align-items-center  mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link  <%=activepage==='home'?'active':''%> " aria-current="page" href="/" target="_blank">Home</a>
        </li>
         <li class="nav-item">
          <a class="nav-link   <%=activepage==='quiz'?'active':''%> " aria-current="page" href="/quiz" target="_blank">Find Your Fragrance</a>
        </li>
        <li class="nav-item">
          <a class="nav-link  <%=activepage==='shop'?'active':''%>" href="/shop" target="_blank">Shop</a>
        </li>
      
        <li class="nav-item">
          <a class="nav-link  <%=activepage==='aboutus'?'active':''%>" href="/aboutus" target="_blank">About</a>
        </li>
        <li class="nav-item">
          <a class="nav-link  <%=activepage==='contact'?'active':''%> " href="/contact" target="_blank">Contact</a>
        </li>
      
      <!--testing item-->
      <li class="nav-item">
          <a href="/cart" class="nav-link p-0   text-dark position-relative fs-4 ms-3">
        <i class="bi bi-cart3"></i>
        <% if (cartcount > 0) { %>
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill " style="font-size: 0.6rem;background-color: var( --brand-accent);">
            <%=cartcount%>
        </span>
    <% } %>
    </a>
        </li>
     
      <li class="nav-item">
        <% if (user) { %>
    <div class="dropdown">
        <a class="nav-link text-dark p-0 fs-4 ms-3" 
           style="cursor:pointer; text-decoration:none;" 
           data-bs-toggle="dropdown">
            <i class="bi bi-person-circle"></i>
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><span class="dropdown-item-text fw-bold"><%= user.name %></span></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/orders">My Orders</a></li>
            <li><a class="dropdown-item" href="/logout">Logout</a></li>
        </ul>
    </div>
<% } else { %>
    <a href="#" class=" nav-link d-flex p-0 align-items-center text-dark fs-4 ms-3" 
       data-bs-toggle="modal" 
       data-bs-target="#authmodal">
        <i class="bi bi-person-circle"></i>
    </a>
<% } %>
        </li>
      </ul>
       
     
   
</div>
    </div>

</nav>
<!--authmodal-->
<div class="modal fade" id="authmodal" tabindex="-1" aria-labelledby="loginmodal" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      
      <div class="modal-header d-flex flex-column align-items-center justify-content-center">
        <button type="button" class="btn-close btn-checkout" data-bs-dismiss="modal" aria-label="Close"></button>
        <h1 class="modal-title fs-2 section-heading" id="loginmodal">Login</h1>
        <p>Welcome back! Sign in to continue shopping.</p>
      </div>

      <form id="loginForm">
        <div class="modal-body">
          <div id="loginError" class="alert alert-danger mt-2" style="display:none;"></div>
          <div class="mb-1">
            <label for="loginEmail" class="form-label card-text fw-bold">Email</label>
            <input type="email" class="form-control" id="loginEmail" required>
          </div>
          <div class="mb-1">
            <label for="loginPassword" class="form-label card-text fw-bold">Password</label>
            <input type="password" class="form-control" id="loginPassword" required>
          </div>
        </div>
        <div class="modal-footer d-flex flex-column">
          <button type="submit" class="btn btn-checkout">Login</button>
          <p class="card-text">Don't have an account?</p>
          <a href="#" data-bs-toggle="modal" class="card-text text-decoration-none" data-bs-target="#signupmodal" data-bs-dismiss="modal">Create one!</a>
        </div>
      </form>

    </div>
  </div>
</div>

<!--new modal/signup modal -->
<div class="modal fade" id="signupmodal" tabindex="-1" aria-labelledby="signupmodalheader" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-2 section-heading" id="signupmodalheader">Create Account</h1>
        <button type="button" class="btn-close btn-checkout" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form id="registerForm">
        <div class="modal-body">
          <div id="registerError" class="alert alert-danger mt-2" style="display:none;"></div>
          <div class="mb-1">
            <label for="name" class="form-label card-text fw-bold">Full Name:</label>
            <input type="text" class="form-control" id="name" required>
          </div>
          <div class="mb-1">
            <label for="signupEmail" class="form-label card-text fw-bold">Email</label>
            <input type="email" class="form-control" id="signupEmail" required>
          </div>
          <div class="mb-1">
            <label for="signupPassword" class="form-label fw-bold card-text">Password</label>
            <input type="password" class="form-control" id="signupPassword" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-checkout" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-checkout">Register/Create Account</button>
        </div>
      </form>

    </div>
  </div>
</div>
