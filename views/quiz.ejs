          <label class="form-check-label" for="weather-hot">☀️ Warm & Hot Weather</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="weather" id="weather-mild" value="mild">
          <label class="form-check-label" for="weather-mild">🌤️ Mild & Moderate Climate</label>
        </div>
