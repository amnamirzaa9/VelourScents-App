 <script>
  
  const quizForm = document.getElementById('quiz-form');
  const loadingOverlay = document.getElementById('loading-overlay');
  const loadingText = document.getElementById('loading-text');
  const loadingBar = document.getElementById('loading-bar');

  quizForm.addEventListener('submit', function (e) {
    e.preventDefault(); // Stop instant submission

    // Show loading overlay
    loadingOverlay.classList.remove('d-none');

    // Sequence of loading steps
    const steps = [
      { text: "Evaluating gender & occasion profile...", progress: 30 },
      { text: "Filtering climate and longevity factors...", progress: 60 },
      { text: "Scoring fragrance note matches...", progress: 85 },
      { text: "Curating your top 3 recommendations...", progress: 100 }
    ];

    let currentStep = 0;

    const interval = setInterval(() => {
      if (currentStep < steps.length) {
        loadingText.textContent = steps[currentStep].text;
        loadingBar.style.width = steps[currentStep].progress + '%';
        currentStep++;
      } else {
        clearInterval(interval);
        // Submit the form to the server once animation finishes
        quizForm.submit();
      }
    }, 700); // Changes text every 700ms (total ~2.8 seconds)
  });

 </script>
