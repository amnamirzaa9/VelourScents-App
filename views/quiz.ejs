    <!-- QUESTION 7: ADVENTUROUSNESS -->
    <div class="quiz-question" id="q7" style="display:none;">
    <div class="quiz-step mb-4">
      <p class="card-text fw-bold mb-2">How adventurous are you feeling with your fragrance choice?</p>
