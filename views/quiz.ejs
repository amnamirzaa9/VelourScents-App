          <label class="form-check-label" for="scent-floral">🌸 Floral & Elegant</label>
        </div>
      </div>
    </div>
</div> 
    <!-- QUESTION 5: PROJECTION -->
    <div class="quiz-question" id="q5" style="display:none;">
    <div class="quiz-step mb-4">
