              class="progress-bar" 
              role="progressbar"  
              style="width: 12%; background-color: var(--brand-accent); border-radius: 10px;" 
              aria-valuenow="1"  
              aria-valuemin="0"  
              aria-valuemax="7"> 
         </div> 
    </div> 
</div>

    <!-- QUESTION 1: GENDER -->
     <div class="quiz-question" id="q1" style="display:none;">
    <div class="quiz-step mb-4">
      <p class="card-text fw-bold mb-2">Who are you shopping for?</p>
      <div class="d-flex flex-column gap-2">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="gender" id="gender-women" value="women" required>
          <label class="form-check-label" for="gender-women">👩 Women</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="gender" id="gender-men" value="men">
          <label class="form-check-label" for="gender-men"> 👨 Men</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="gender" id="gender-unisex" value="unisex">
          <label class="form-check-label" for="gender-unisex"> 👥 Unisex / Anyone</label>
        </div>
      </div>
    </div>
</div>
    <!-- QUESTION 2: OCCASION -->
     <div class="quiz-question" id="q2" style="display:none;">
    <div class="quiz-step mb-4">
      <p class="card-text fw-bold mb-2">What is the primary occasion for this fragrance?</p>
      <div class="d-flex flex-column gap-2">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="occasion" id="occ-uni" value="university" required>
          <label class="form-check-label" for="occ-uni">🎓 University & Campus Wear</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="occasion" id="occ-office" value="office">
          <label class="form-check-label" for="occ-office">💼 Office & Professional Settings</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="occasion" id="occ-wedding" value="wedding">
          <label class="form-check-label" for="occ-wedding">💍 Weddings & Formal Events</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="occasion" id="occ-eid" value="eid">
          <label class="form-check-label" for="occ-eid">🌙 Festive Celebrations (Eid)</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="occasion" id="occ-family" value="family">
          <label class="form-check-label" for="occ-family"> 👨‍👩‍👧‍👦 Family Gatherings</label>
        </div>
        <div class="form-check">
