          <label class="form-check-label" for="proj-strong">🔥 Bold & Powerful</label>
        </div>
      </div>
    </div>
</div>
    <!-- QUESTION 6: LONGEVITY -->
    <div class="quiz-question" id="q6" style="display:none;">
    <div class="quiz-step mb-4">
