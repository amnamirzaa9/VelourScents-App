        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="adventurousness" id="adv-different" value="different">
          <label class="form-check-label" for="adv-different">✦ Modern & Slightly Unique — a little different</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="adventurousness" id="adv-distinctive" value="distinctive">
          <label class="form-check-label" for="adv-distinctive">🖤 Bold & Niche — distinctive and unconventional </label>
        </div>
      </div>
    </div>
    </div>
