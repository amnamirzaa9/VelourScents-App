
<%-include('partials/header',{activepage:'',title:'FAQs',cartcount:cartcount})%>
<!--section-->
<section>
<h2 class="section-heading">Frequently Asked Questions</h2>
<p class="lead">Everything you need to know before you order</p>
<!--accordion-->
<div class="accordion mb-5 container accordion-flush" id="accordionFlushExample">
  <!--question1-->
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
        1. How long does delivery take?
      </button>
    </h2>
    <div id="flush-collapseOne" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
      <div class="accordion-body">Orders within major cities (Lahore, Karachi, Islamabad, Rawalpindi) typically arrive within 2-3 business days. Other cities may take 4-6 business days depending on courier service in your area.</div>
    </div>
  </div>
  <!--question2-->
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseTwo" aria-expanded="false" aria-controls="flush-collapseTwo">
       2. Do you offer Cash on Delivery (COD)?
      </button>
    </h2>
    <div id="flush-collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
      <div class="accordion-body">Yes, COD is available across Pakistan. You can also pay online via bank transfer or card at checkout.</div>
    </div>
  </div>
  <!--question3-->
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseThree" aria-expanded="false" aria-controls="flush-collapseThree">
        3. Are Velour Scents perfumes original or local (non-branded)?
      </button>
    </h2>
    <div id="flush-collapseThree" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
      <div class="accordion-body">All our perfumes are made in-house with high-quality, imported fragrance oils. We are not a reseller of foreign designer brands — every scent is our own original blend.</div>
    </div>
  </div>
  <!--question4-->
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapsefour" aria-expanded="false" aria-controls="flush-collapsefour">
        4. Do your perfumes contain alcohol?
      </button>
    </h2>
    <div id="flush-collapsefour" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
      <div class="accordion-body">Most of our perfumes are Eau de Parfum (alcohol-based) for long-lasting wear. If you'd like an alcohol-free option, please check the product description or contact us before ordering.</div>
    </div>
  </div>
  <!--question5-->
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapsefive" aria-expanded="false" aria-controls="flush-collapsefive">
        5. How long does the fragrance usually last?
      </button>
    </h2>
    <div id="flush-collapsefive" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
      <div class="accordion-body">On average, our perfumes last 6-8 hours depending on your skin type and the weather. Application on pulse points (wrists, neck) helps the scent last longer.</div>
    </div>
  </div>
  <!--question6-->
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapsesix" aria-expanded="false" aria-controls="flush-collapsesix">
       6. Can I get a sample before buying a full bottle?
      </button>
    </h2>
    <div id="flush-collapsesix" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
      <div class="accordion-body">
        Currently we don't offer individual samples, but our 30ml bottles are a great affordable way to try a new scent before committing to a larger size.
      </div>
    </div>
  </div>
  <!--question7-->
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseseven" aria-expanded="false" aria-controls="flush-collapseseven">
       7. Do you deliver outside Pakistan?
      </button>
    </h2>
    <div id="flush-collapseseven" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
      <div class="accordion-body">
       At the moment, we only deliver within Pakistan. International shipping may be introduced in the future.
      </div>
    </div>
  </div>
</div>
</section>
<%-include('partials/footer')%>
 
</div>




