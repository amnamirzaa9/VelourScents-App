<%- include('partials/header', { activepage: '', title: 'My Orders', cartcount: cartcount, user: user }) %>



<div class="container orders-page">

    <div class="orders-header">
        <h2 class="section-heading">My Orders</h2>

        <% if (userorders.length === 0) { %>

            <p class="orders-subtitle">You haven't placed any orders yet.</p>

        <% } else { %>

            <p class="orders-subtitle">Here are your previous orders.</p>

        <% } %>
    </div>

    <% if (userorders.length === 0) { %>

        <div class="empty-orders">
            <div class="empty-orders-icon">
                <i class="bi bi-bag"></i>
            </div>

            <h4>No orders yet</h4>
            <p>Your completed orders will appear here.</p>
        </div>

    <% } else { %>
      <div class="row g-4">
        <% userorders.forEach(order => { %>
          
            <% const ordercart = order.items; %>
            <div class="col-12 col-sm-6 col-md-4">
            <div class="order-card h-100">

                <div class="order-card-header">
                    <div>
                        <p class="order-label">Order ID</p>
                        <h5 class="order-id">#<%= order._id %></h5>
                    </div>

                    <span class="order-badge">
                        <%= ordercart.length %>
                        <%= ordercart.length === 1 ? 'Item' : 'Items' %>
                    </span>
                </div>

                <div class="order-card-body">

                    <div class="products-title">Products</div>

                    <% ordercart.forEach((item, index) => { %>

                        <div class="product-row">
                            <div class="product-info">
                                <span class="product-number">
                                    <%= index + 1 %>
                                </span>

                                <p class="product-name">
                                    <%= item.name %>
                                </p>
                            </div>
                        </div>

                    <% }) %>

                    <div class="order-total">
                        <span class="total-label">Order Total</span>
                        <span class="total-value">
                            <%= order.subtotal %>
                        </span>
                    </div>

                </div>
            </div>
            </div>
           
        <% }) %>

    <% } %>
    </div>
</div>

<%- include('partials/footer') %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

</body>
</html>
