<%-include('partials/header',{activepage:'',title:'cart',cartcount:cartcount})%>
<!-- cart section -->
<% if (subtotal != 0) { %>

    <h2 class="section-heading fs-2 text-uppercase">
        Your Cart
    </h2>

    <div class="container mb-5 " style="min-height: 500px;">

        <div class="row g-4 align-items-start ">

            <!-- Cart Items -->
            <div class="col-12 col-lg-7">

                <div class="cart-table">

                    <% cart.forEach((item, i) => { %>

                        <div class="card border-0 shadow-sm mb-3">

                            <div class="card-body py-3">

                                <div class="row align-items-center">

                                    <!-- Number -->
                                    <div class="col-2 col-sm-1 text-center">
                                        <span class="fw-semibold">
                                            <%= i + 1 %>
                                        </span>
                                    </div>

                                    <!-- Product -->
                                    <div class="col-10 col-sm-4">
                                        <div class="card-text fw-semibold">
                                            <%= item.name %>
                                        </div>
                                    </div>

                                    <!-- Price -->
                                    <div class="col-4 col-sm-2 text-center">
                                        <small class="text-muted d-block">
                                            Price
                                        </small>
                                        <span class="card-text text-nowrap">
                                            Rs. <%= item.price %>
                                        </span>
                                    </div>

                                    <!-- Quantity -->
                                    <div class="col-4 col-sm-2 text-center">
                                        <small class="text-muted d-block">
                                            Quantity
                                        </small>
                                        <span class="card-text">
                                            <%= item.quantity %>
                                        </span>
                                    </div>

                                    <!-- Total -->
                                    <div class="col-4 col-sm-2 text-center">
                                        <small class="text-muted d-block">
                                            Total
                                        </small>
                                        <span class="card-text fw-semibold text-nowrap">
                                            Rs. <%= item.price * item.quantity %>
                                        </span>
                                    </div>

                                    <!-- Remove -->
                                    <div class="col-12 col-sm-1 text-center">

                                        <form action="/remove-from-cart/<%= i %>" method="POST">

                                            <button type="submit"
                                                    class="btn btn-sm border-0"
                                                    aria-label="Remove item">

                                                <i class="bi bi-x-circle"></i>

                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                </div>

            </div>


            <!-- Cart Summary -->
            <div class="col-12 col-lg-5">

                <div class="card border-0 shadow-sm cart-summary-card">

                    <div class="card-body p-4">

                        <h5 class="card-title mb-4">
                            Cart Summary
                        </h5>

                        <p class="card-text mb-3">
                            Rs. <%= subtotal %>
                        </p>

                        <p class="card-text mb-4">
                            Shipping :
                            <%= subtotal > 5000
                                ? 'Free Delivery'
                                : 'Standard delivery charges apply'
                            %>
                        </p>

                        <a href="/checkout" class="btn btn-checkout w-100">
                            Proceed to Checkout
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


<% } else { %>

    <!-- Empty Cart -->

    <h2 class="section-heading fs-2 text-uppercase">
        Your Cart
    </h2>

    <div class="container d-flex justify-content-center align-items-center w-75"
         style="min-height:500px">

        <div class="row w-100 justify-content-center">

            <div class="col-md-6 col-12">

                <div class="card w-100 cart-summary-card">

                    <div class="card-body text-center py-5">

                        <h5 class="card-title fs-4 mb-3">
                            Your Cart is Empty
                        </h5>

                        <p class="card-text text-muted mb-4">
                            Looks like you haven't added anything to your cart yet.
                        </p>

                        <a href="/shop" class="btn btn-checkout px-4">
                            Continue Shopping
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

<% } %>


<%-include('partials/footer')%>
 
</div>
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  <script src="js/someotherproducts.js"></script>
</body>
</html>