<%-include('partials/header',{activepage:'',title:'cart',cartcount:cartcount})%>
<!-- cart section -->

<% if (subtotal != 0) { %>

    <h2 class="section-heading fs-2 text-uppercase">
        Your Cart
    </h2>

    <!-- cart -->
    <div class="container d-flex flex-column justify-content-center w-75 gap-3" style="min-height:500px">

        <div class="row g-3">

            <!-- Cart Table -->
            <div class="col-md-6">

                <div class="table-responsive h-100 cart-table">

                    <table class="table borderless">

                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Product</th>
                                <th scope="col">Price</th>
                                <th scope="col">Quantity</th>
                                <th scope="col">Total</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% cart.forEach((item, i) => { %>

                                <tr>

                                    <th scope="row">
                                        <%= i + 1 %>
                                    </th>

                                    <td class="card-text">
                                        <%= item.name %>
                                    </td>

                                    <td class="card-text">
                                        Rs. <%= item.price %>
                                    </td>

                                    <td class="card-text">
                                        <%= item.quantity %>
                                    </td>

                                    <td class="card-text">
                                        Rs. <%= item.price * item.quantity %>
                                    </td>

                                    <td>
                                        <form action="/remove-from-cart/<%= i %>" method="POST">

                                            <button type="submit" class="btn btn-sm border-0">
                                                <i class="bi bi-x-circle"></i>
                                            </button>

                                        </form>
                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- Cart Summary -->
            <div class="col-md-6">

                <div class="card h-100 cart-summary-card">

                    <div class="card-body">

                        <h5 class="card-title">
                            Cart Summary
                        </h5>

                        <p class="card-text">
                            Rs. <%= subtotal %>
                        </p>

                        <p class="card-text">
                            Shipping :
                            <%= subtotal > 5000
                                ? 'Free Delivery'
                                : 'Standard delivery charges apply'
                            %>
                        </p>

                        <p class="card-text">
                        </p>

                        <a href="/checkout" class="btn btn-checkout">
                            Proceed to Checkout
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


<% } else { %>

    <!-- Empty Cart -->

    <h2 class="section-heading fs-2 text-uppercase">
        Your Cart
    </h2>

    <div class="container d-flex justify-content-center align-items-center w-75" style="min-height:500px">

        <div class="row w-100 justify-content-center">

            <div class="col-md-6 col-12">

                <div class="card w-100 cart-summary-card">

                    <div class="card-body text-center py-5">

                        <h5 class="card-title fs-4 mb-3">
                            Your Cart is Empty
                        </h5>

                        <p class="card-text text-muted mb-4">
                            Looks like you haven't added anything to your cart yet.
                        </p>

                        <a href="/shop" class="btn btn-checkout px-4">
                            Continue Shopping
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

<% } %>

<%-include('partials/footer')%>
 
</div>
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  <script src="js/someotherproducts.js"></script>
</body>
</html>