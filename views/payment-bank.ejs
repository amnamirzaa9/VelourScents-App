<%- include('partials/header', { activePage: '', title: 'Bank Transfer', cartcount: cartcount , user: user}) %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">

      <!-- Header -->
      <div class="d-flex align-items-center gap-3 p-3 rounded-3 mb-4" style="background-color: #006400;">
        <i class="bi bi-bank text-white fs-2"></i>
        <div>
          <h4 class="text-white mb-0">Bank Transfer</h4>
          <small class="text-white-50">Direct bank payment</small>
          ⚠️ <strong>Demo Project Notice:</strong> <p class="text-white"> Please do not attempt to transfer any actual funds.</p>
        </div>
      </div>

      <!-- Order Summary -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <p class="text-muted small mb-1">Amount to transfer</p>
          <h3 class="section-heading mb-0">Rs. <%= subtotal %></h3>
        </div>
      </div>

      <!-- Bank Details -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <h6 class="text-muted text-uppercase small mb-3">Bank Details</h6>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted small">Bank</span>
            <span class="fw-500 small">HBL</span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted small">Account title</span>
            <span class="fw-500 small">Velour Scents</span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted small">Account number</span>
            <span class="fw-500 small">1234-5678-9012</span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted small">IBAN</span>
            <span class="fw-500 small">PK36HABB0000001234567890</span>
          </div>
          <hr>
          <div class="d-flex justify-content-between">
            <span class="text-muted small">Amount</span>
            <span class="fw-500 small">Rs. <%= subtotal %></span>
          </div>
        </div>
      </div>

      <!-- Info -->
      <div class="alert" style="background-color: #f0f0f0; border: none; border-radius: 10px;">
        <i class="bi bi-info-circle me-2"></i>
        Transfer the exact amount and click confirm. Your order will be processed after payment verification.
      </div>

      <!-- Confirm Button -->
      <form action="/confirm-order" class="needs-validation" method="POST">
        <button type="submit" class="btn w-100 text-white py-3 mt-2" style="background-color: #006400; border-radius: 10px;">
          I've transferred the amount
        </button>
      </form>

      <a href="/checkout" class="btn btn-link text-muted d-block text-center mt-3">← Go back</a>

    </div>
  </div>
</div>

<%- include('partials/footer') %>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script>
(()=>{
  'use strict';
  const forms=document.querySelectorAll('.needs-validation');
  Array.from(forms).forEach(form=>{
    form.addEventListener('submit',event=>{
      if(!form.checkValidity()){
         event.preventDefault();
                event.stopPropagation();
      }
      form.classList.add('was-validated')
    })
  })

})();
</script>
</body>
</html>