<%-include('partials/header',{activepage:'',title:'Search',cartcount:0})%>
<main class="search-page">
<% if(!products || products.length==0){%>
 <div class="col-12  d-flex justify-content-center align-items-center"  style="min-height:450px;">
  
    <p class="card-text  text-center">No results could be found.Please try again with a different query</p>
    
    </div>
<%}else{%>

<section id="women">
  <h2 class="section-heading">Related Search Products</h2>
 <div id="women-container" class="row  g-4 mb-4"> 
 <% products.forEach((product)=>{%>
 
    <div class=" col-sm-4 col-6 ">
  <div class="card p-2 h-100">
  <img src="<%=product.image%>" class="card-img-top" alt="...">
  <div class="card-body">
    <h5 class="card-title"><%=product.name%></h5>
    <p class="card-text"> Rs.<%=product.price%></p>
    <a href="/product-detail/<%=product._id%>" class="text-decoration-none card-text mb-3 fs-bold" style="display: block;">View Product</a>
   
  </div>



</div>
</div>

<%});%>
 </div>
 

</section>
<%}%>
</main>
<%-include('partials/footer')%>


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  
</body>
</html>




