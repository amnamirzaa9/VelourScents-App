<%-include('partials/header',{activepage:'',title:'product-detail',cartcount:cartcount})%>

<!--product detail section-->
<div class="row mb-4">
  <!--product image-->
  <div class="col-md-6">
    <img src="/<%=product.image%>" class="img-fluid rounded-3" alt="...">
    </div>
    <!--product-details-->
    <div class="col-md-6 p-3">
     <div class="d-flex align-items-center gap-1 mb-3">
       <h1 class="cart-text fs-6 fs-sm-5 mt-2 ">Category:</h1>
      <button type="button" class="btn btn-lg mt-2 cart-text fs-6 fs-sm-5 btn-outline-secondary"><%=product.category[0]%>
        <% if(product.category[1]){%>
          ,<%=product.category[1]%>
        <%}%>
        </button>
     </div>
      <h1><%=product.name%></h1>
<p class="text-muted fs-md-2 fs-sm-3 fs-4">50ml Eau de Parfum</p>
<p class="text-muted fs-md-3 fs-sm-4 fs-5">Rs.<%=product.price%></p>
<p class="text-muted fs-md-2 fs-sm-3 fs-4"><%=product.description%></p>
     
      <!--quantity selector-->
      <div class="d-flex align-items-center gap-2 mb-3">
        <form action="/add-to-cart/<%=product._id%>" method="post">
    <label for="quantity" class=" text-muted fs-md-2 fs-sm-3 fs-4 mb-0">Quantity:</label>
    <input type="number" id="quantity" name= "quantity" class="form-control" value="1" min="1" style="max-width: 80px;">
    <button  type="submit"  class="btn btn-light p-2 my-3 bt-lg text-dark border border-dark cart-text">Add to Cart</button>
    </form>
</div>
<!--small note-->
<p class="text-muted small">
    <i class="bi bi-check-circle"></i> In stock — ready to ship
</p>
<p class="text-muted small">Free shipping on orders over Rs.5000</p>
 
    </div>
</div>
<!--you might like this-->
<h2 class="section-heading">You might like this</h2>
<div class="row g-4 mb-4" id="some-other-products">
<% someotherproducts.forEach((product)=>{%>
 
    <div class=" col-sm-4 col-6 ">
  <div class="card p-2 h-100">
  <img src="/<%=product.image%>" class="card-img-top" alt="...">
  <div class="card-body">
    <h5 class="card-title"><%=product.name%></h5>
    <p class="card-text"> Rs.<%=product.price%></p>
    
    <a href="/product-detail/<%=product._id%>" class="text-decoration-none card-text mb-3 fs-bold" style="display: block;">View Product</a>
    
    
  </div>

</div>
</div>

<%});%>
 
</div>
<%-include('partials/footer')%>
 
</div>
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
 
</body>
</html>