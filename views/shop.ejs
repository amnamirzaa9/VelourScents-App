<%-include('partials/header',{activepage:'shop',title:'shop',cartcount:cartcount})%>

</div>
<!--handling query-->
<%if(added){%>
  <div class=" mt-3 d-flex  justify-content-center">
  <div class="alert alert-dismissible fade show text-center" style="background-color: var( --brand-soft-pink);width: 450px;max-width: 100%;" role="alert">
  Added to cart!
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
</div>
<%}%>
<!--page heading-->
<h1 class="section-heading my-3">Shop by Category</h1>
<!--categories-->
<!--women category-->
<div class="d-flex justify-content-end align-items-center gap-2 mb-4 px-2">
    <!-- Sort By -->
    <div class="d-flex  align-items-center gap-2">
        <label class="text-muted small card-text" style="color: var(--brand-accent);">Sort By</label>
        <select id="sortSelect" class="form-select form-select-sm" style="max-width: 200px;">
            <option value="featured">Featured</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="a-z">Alphabetically: A-Z</option>
            <option value="z-a">Alphabetically: Z-A</option>
        </select>
    </div>

    <!-- Filters button -->
    <button id="openFilters" class="btn btn-outline-dark btn-sm d-flex align-items-center gap-2">
        <i class="bi bi-sliders"></i> Filters
    </button>
</div>
<section id="women">
  <h2 class="section-heading">Women</h2>
 <div id="women-container" class="row  g-4"> 
 <% women.forEach((product)=>{%>
 
    <div class=" col-sm-4 col-6 product-card " data-price="<%= product.price %>"
         data-name="<%= product.name %>"
         data-category="women"
         data-scent="<%= product.scentProfile %>">
      
  <div class="card p-2 h-100">
  <img src="<%=product.image%>" class="card-img-top" alt="...">
  <div class="card-body">
    <h5 class="card-title"><%=product.name%></h5>
    <p class="card-text"> Rs.<%=product.price%></p>
    
    <a href="/product-detail/<%=product._id%>" class="text-decoration-none card-text  mb-3 fs-bold" style="display: block;">View Product</a>
   
  </div>
</div>
</div>

<%});%>
 </div>
 

</section>
<!--men category-->
<section id="men">
  <h2 class="section-heading mt-3 ">Men</h2>
 <div id="men-container" class="row  g-4">
  <% men.forEach((product)=>{%>
    <div class=" col-sm-4 col-6 product-card" data-price="<%= product.price %>"
     data-name="<%= product.name %>"
     data-category="men"
     data-scent="<%= product.scentProfile %>">
  <div class="card p-2 h-100">
  <img src="<%=product.image%>" class="card-img-top" alt="...">
  <div class="card-body">
    <h5 class="card-title"><%=product.name%></h5>
    <p class="card-text">Rs.<%=product.price%></p>
    
    <a href="/product-detail/<%=product._id%>" class="text-decoration-none card-text mb-3 fs-bold" style="display: block;">View Product</a>
   
  
  </div>
</div>
</div>
<%});%>

 </div>

</section>

<!--new arrivals category-->
<section id="new-arrivals" class="mb-5">
  <h2 class="section-heading mt-3">New Arrivals</h2>
  <div id="new-arrivals-container" class="row  g-4">
    <% newarrivals.forEach((product)=>{%>
    <div class=" col-sm-4 col-6 product-card " data-price="<%= product.price %>"
     data-name="<%= product.name %>"
     data-category="new-arrivals"
     data-scent="<%= product.scentProfile %>">
  <div class="card p-2 h-100">
  <img src="<%=product.image%>" class="card-img-top" alt="...">
  <div class="card-body">
    <h5 class="card-title"><%=product.name%></h5>
    <p class="card-text">Rs.<%=product.price%></p>
    <a href="/product-detail/<%=product._id%>" class="text-decoration-none card-text mb-3 fs-bold" style="display: block;">View Product</a>
    
  
  </div>
</div>
</div>
<%});%>
  </div>

</section>
<!-- Overlay -->
<div id="drawerOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.4); z-index:1000;"></div>

<!-- Filter Drawer -->
<div id="filterDrawer" style="display:none; position:fixed; top:0; right:0; width:320px; height:100%; background:white; z-index:1001; padding:2rem; overflow-y:auto; box-shadow: -4px 0 15px rgba(0,0,0,0.1);">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="text-uppercase mb-0" style="letter-spacing:2px;">Filters</h5>
        <button id="closeFilters" class="btn btn-sm border-0 fs-5">×</button>
    </div>

    <hr>

    <!-- Price Range -->
    <div class="mb-4">
        <h6 class="text-uppercase mb-3" style="letter-spacing:1px; font-size:0.75rem;">Price</h6>
        <input type="range" class="form-range mb-3" id="priceSlider" min="2000" max="3200" value="3200" step="100">
        <div class="d-flex gap-2 align-items-center">
            <div class="input-group input-group-sm">
                <span class="input-group-text">Rs</span>
                <input type="number" id="priceMin" class="form-control" value="2000" readonly>
            </div>
            <span class="text-muted">to</span>
            <div class="input-group input-group-sm">
                <span class="input-group-text">Rs</span>
                <input type="number" id="priceMax" class="form-control" value="3200">
            </div>
        </div>
    </div>

    <hr>

    <!-- Scent Profile -->
    <div class="mb-4">
        <h6 class="text-uppercase mb-3" style="letter-spacing:1px; font-size:0.75rem;">Scent Profile</h6>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-sm text-dark border scent-filter" data-scent="fresh" >Fresh</button>
            <button class="btn btn-sm text-dark border  scent-filter" data-scent="floral" >Floral</button>
            <button class="btn btn-sm text-dark border  scent-filter" data-scent="woody" >Woody</button>
            <button class="btn btn-sm text-dark border  scent-filter" data-scent="spicy" >Spicy</button>
            <button class="btn btn-sm text-dark border scent-filter" data-scent="sweet" >Sweet</button>
        </div>
    </div>

    <hr>

    <!-- View Results button -->
    <button id="applyFilters" class="btn w-100 text-white py-3 mt-3" style="background-color: var(--brand-accent); border-radius: 8px;">
        VIEW RESULTS
    </button>

    <!-- Clear Filters -->
    <button id="clearFilters" class="btn btn-link w-100 text-muted mt-2">
        Clear all filters
    </button>
</div>
<%-include('partials/footer')%>


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  <script>
    // Store all cards + their original order
    const allCards = [...document.querySelectorAll('.product-card')];
    const containers = {
        women: document.getElementById('women-container'),
        men: document.getElementById('men-container'),
        'new-arrivals': document.getElementById('new-arrivals-container')
    };
    console.log("Women container:", containers.women);
console.log("Women cards:", containers.women.querySelectorAll('.product-card').length);
    // Track active filters
    let activeScent = null;
    let activeMaxPrice = 3200;

    // ── DRAWER OPEN/CLOSE ──
    document.getElementById('openFilters').addEventListener('click', () => {
        document.getElementById('filterDrawer').style.display = 'block';
        document.getElementById('drawerOverlay').style.display = 'block';
    });

    function closeDrawer() {
        document.getElementById('filterDrawer').style.display = 'none';
        document.getElementById('drawerOverlay').style.display = 'none';
    }

    document.getElementById('closeFilters').addEventListener('click', closeDrawer);
    document.getElementById('drawerOverlay').addEventListener('click', closeDrawer);

    // ── PRICE SLIDER ──
    document.getElementById('priceSlider').addEventListener('input', function() {
        activeMaxPrice = parseInt(this.value);
        document.getElementById('priceMax').value = activeMaxPrice;
    });

    // ── SCENT FILTER BUTTONS ──
    document.querySelectorAll('.scent-filter').forEach(btn => {
        btn.addEventListener('click', function() {
            if (activeScent === this.dataset.scent) {
    activeScent = null;
    this.classList.remove('selected');
} else {
    document.querySelectorAll('.scent-filter').forEach(b => {
        b.classList.remove('selected');
    });
    activeScent = this.dataset.scent;
    this.classList.add('selected');
}
        });
    });

    // ── APPLY FILTERS ──
    //function applyFilters() {
       /* allCards.forEach(card => {
            const price = parseInt(card.dataset.price);
            const scent = card.dataset.scent;

            const priceMatch = price <= activeMaxPrice;
            const scentMatch = !activeScent || scent === activeScent;
            
            card.style.display = (priceMatch && scentMatch) ? '' : 'none';
            
     });
         Object.keys(containers).forEach(category => {
        const container = containers[category];
        if (!container) return;
        const visibleCards = [...container.querySelectorAll('.product-card')]
            .filter(card => card.style.display !== 'none');
        
        if (visibleCards.length === 0) {
            const msg = document.createElement('p');
            msg.className = 'text-muted p-3 no-results-msg';
            msg.textContent = 'No products match your filters in this category.';
            container.appendChild(msg);
        }
    });
        closeDrawer();
    }*/
    function applyFilters() {

    allCards.forEach(card => {

        const price = parseInt(card.dataset.price);
        const scent = card.dataset.scent;

        const priceMatch = price <= activeMaxPrice;
        const scentMatch = !activeScent || scent === activeScent;

        card.style.display =
            (priceMatch && scentMatch) ? '' : 'none';
    });

    Object.keys(containers).forEach(category => {

        const container = containers[category];

        if (!container) return;

        // Remove old message
        const oldMsg = container.querySelector('.no-results-msg');

        if (oldMsg) {
            oldMsg.remove();
        }

        const visibleCards = [
            ...container.querySelectorAll('.product-card')
        ].filter(card => card.style.display !== 'none');

        console.log(category, "visible cards:", visibleCards.length);

        if (visibleCards.length === 0) {

            const msg = document.createElement('p');

            msg.className = 'text-muted p-3 no-results-msg';

            msg.textContent =
                'No products match your filters in this category.';

            container.appendChild(msg);
        }
    });

    closeDrawer();
}
    document.getElementById('applyFilters').addEventListener('click', applyFilters);

    // ── CLEAR FILTERS ──
    document.getElementById('clearFilters').addEventListener('click', () => {
        activeScent = null;
        activeMaxPrice = 3200;
        document.getElementById('priceSlider').value = 3200;
        document.getElementById('priceMax').value = 3200;
        document.querySelectorAll('.scent-filter').forEach(b => {
            b.classList.remove('active', 'btn-dark');
            b.classList.add('btn-outline-secondary');
        });
        allCards.forEach(card => card.style.display = '');
        closeDrawer();
    });

    // ── SORT ──
    document.getElementById('sortSelect').addEventListener('change', function() {
        const value = this.value;

        allCards.sort((a, b) => {
            const priceA = parseInt(a.dataset.price);
            const priceB = parseInt(b.dataset.price);
            const nameA = a.dataset.name.toLowerCase();
            const nameB = b.dataset.name.toLowerCase();

            if (value === 'price-low') return priceA - priceB;
            if (value === 'price-high') return priceB - priceA;
            if (value === 'a-z') return nameA.localeCompare(nameB);
            if (value === 'z-a') return nameB.localeCompare(nameA);
            return 0;
        });

        // Re-append sorted cards to their containers
        allCards.forEach(card => {
            const category = card.dataset.category;
            const container = containers[category];
            if (container) container.appendChild(card);
        });
    });
</script>
  
</body>
</html>




